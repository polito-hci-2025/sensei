z### MYWORKS

# Ottieni tutti i myworks
GET http://localhost:3001/api/myworks

###

# Ottieni mywork specifico per ID
GET http://localhost:3001/api/myworks/4

###

# Crea nuovo PDF
POST http://localhost:3001/api/myworks/create
content-type: application/json

{
  "NamePDF": "Matematica - Equazioni",
  "Subject": "Matematica",
  "Grade": "3° Media",
  "Tag": "algebra",
  "Description": "Esercizi sulle equazioni di primo grado",
  "Shared": 0,
  "Download": 0,
  "Prof": "Prof. Rossi",
  "Type": "created"
}

###

# Modifica informazioni di un mywork
PUT http://localhost:3001/api/myworks/4/edit
content-type: application/json

{
  "NamePDF": "Matematica - Equazioni Avanzate",
  "Description": "Esercizi avanzati sulle equazioni",
  "Subject": "Matematica",
  "Grade": "3° Media",
  "Shared": 1
}

###

# Elimina un mywork
DELETE http://localhost:3001/api/myworks/4/delete

###

### SHAREDWORKS

# Ottieni tutti i sharedworks
GET http://localhost:3001/api/sharedworks

###

# Ottieni sharedwork specifico per ID
GET http://localhost:3001/api/sharedworks/1
content-type: application/json

###

# Incrementa il contatore download di un sharedwork
PUT http://localhost:3001/api/sharedworks/1/download
content-type: application/json

###

### CREATEPDF (Gestione contenuti PDF)

# Ottieni tutti i contenuti di un PDF
GET http://localhost:3001/api/createpdf/3/content


# ottieni uno specifico contenuto di un PDF
GET http://localhost:3001/api/createpdf/3/content/2
###

# Crea nuovo contenuto per un PDF
POST http://localhost:3001/api/createpdf/3/content
content-type: application/json

{
  "type": "questiondipr",
  "content": "Risolvi l'equazione: 2x + 5 = 15",
  "answers": "risposta"
}

###

# Modifica contenuto specifico di un PDF
PUT http://localhost:3001/api/createpdf/3/content/7/edit
content-type: application/json

{
  "type": "questionnuova111",
  "content": "Risolvi l'equazione: 3x + 7 = 22"
}

###

# Elimina tutto il contenuto di un PDF
DELETE http://localhost:3001/api/createpdf/1/content/delete

###

# Elimina contenuto specifico di un PDF
DELETE http://localhost:3001/api/createpdf/1/content/4/delete
